{
  "type": "module",
  "private": true,
  "scripts": {
    "check": "biome check .",
    "test": "vitest",
    "check:types": "tsgo -b tsconfig.json",
    "deploy": "wrangler deploy",
    "deps": "pnpx taze",
    "deps:ci": "pnpx actions-up",
    "dev": "wrangler dev",
    "gen:types": "wrangler types src/worker-configuration.d.ts",
    "preinstall": "pnpx only-allow pnpm",
    "prepare": "pnpm gen:types && simple-git-hooks"
  },
  "dependencies": {
    "mppx": "0.1.0",
    "viem": "2.45.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@cloudflare/vitest-pool-workers": "^0.12.12",
    "@types/turndown": "^5.0.6",
    "@typescript/native-preview": "7.0.0-dev.20260124.1",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.62.0"
  },
  "packageManager": "pnpm@10.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.5.1",
      "onFail": "download"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --write --staged --no-errors-on-unmatched && git update-index --again"
  }
}
