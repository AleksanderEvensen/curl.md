{
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "check": "biome check .",
    "check:types": "tsgo -b",
    "deploy": "pnpm run build && wrangler deploy",
    "deps": "pnpx taze",
    "deps:ci": "pnpx actions-up",
    "dev": "vite dev --port 3000",
    "gen:types": "wrangler types src/worker-configuration.d.ts",
    "preinstall": "pnpx only-allow pnpm",
    "prepare": "pnpm gen:types && simple-git-hooks",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run --config test/vitest.config.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.13.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@tailwindcss/vite": "^4.1.18",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260216.1",
    "@vitejs/plugin-react": "^5.0.4",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18",
    "tiny-jsonc": "^1.0.2",
    "vite": "^7.1.7",
    "vitest": "^4.0.18",
    "wrangler": "^4.65.0"
  },
  "packageManager": "pnpm@10.22.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.5.1",
      "onFail": "download"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm biome check --write --staged --no-errors-on-unmatched && git update-index --again"
  }
}
