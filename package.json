{
  "name": "root",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*",
    "#config/*": "./config/*",
    "#db/*": "./db/*",
    "#docs/*": "./docs/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "amp": "node --experimental-strip-types scripts/plugin.ts amp",
    "build": "vite build",
    "build:cli": "pnpm --filter curl.md build",
    "claude": "node --experimental-strip-types scripts/plugin.ts claude",
    "check": "oxlint ${CI:+--deny-warnings} && oxfmt",
    "check:deps": "knip --config config/knip.json",
    "check:types": "tsgo -b && pnpm -r check:types",
    "db": "docker exec -it curl-db psql -U postgres -d curl_dev",
    "db:command": "docker exec curl-db psql -U postgres -d curl_dev -c",
    "db:codegen": "node --experimental-strip-types db/codegen.ts",
    "db:make": "kysely --config=db/kysely.config.ts migrate make",
    "db:migrate": "kysely --config=db/kysely.config.ts migrate",
    "deps": "pnpx taze -r --no-ignore-other-workspaces --ignore-paths node_modules",
    "deps:ci": "pnpx actions-up --dir .github",
    "dev": "docker compose up -d",
    "gen:claude": "node --experimental-strip-types plugins/claude/scripts/sync.ts",
    "gen:fixtures:md:rules": "node --experimental-strip-types scripts/updateMdRulesFixtures.ts",
    "gen:types": "cp -n .env.example .env 2>/dev/null; wrangler types src/worker-configuration.d.ts && node --experimental-strip-types scripts/updateWranglerTypes.ts && pnpm --filter curl.md gen:types",
    "md": "CURLMD_BASE_URL=https://curl.local NODE_TLS_REJECT_UNAUTHORIZED=0 node --experimental-strip-types cli/src/bin.ts",
    "opencode": "node --experimental-strip-types scripts/plugin.ts opencode",
    "pi": "node --experimental-strip-types scripts/plugin.ts pi",
    "plugin": "node --experimental-strip-types scripts/plugin.ts",
    "preconstruct": "node --experimental-strip-types scripts/preconstruct.ts",
    "preinstall": "pnpx only-allow pnpm",
    "prepare": "pnpm gen:claude && pnpm gen:types && pnpm preconstruct && simple-git-hooks",
    "preview": "pnpm run build && vite preview",
    "changeset:publish": "pnpm --filter curl.md build && pnpm --filter @curl.md/amp build && node --experimental-strip-types scripts/formatPackage.ts && pnpm changeset publish && node --experimental-strip-types scripts/restorePackage.ts",
    "changeset:version": "pnpm changeset version && pnpm gen:claude",
    "test": "vitest --config test/vitest.config.ts",
    "test:e2e": "playwright test --config test/e2e.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@cloudflare/vite-plugin": "^1.34.0",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource/silkscreen": "^5.2.8",
    "@hono/zod-validator": "^0.7.6",
    "@octokit/core": "^7.0.6",
    "@sentry/cloudflare": "^10.51.0",
    "@sentry/tanstackstart-react": "^10.51.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@takumi-rs/image-response": "^1.1.2",
    "@takumi-rs/wasm": "^1.1.2",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "hono": "catalog:",
    "kysely": "^0.28.16",
    "kysely-postgres-js": "^3.0.0",
    "minisearch": "^7.2.0",
    "nanoid": "^5.1.9",
    "postgres": "^3.4.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "stripe": "^20.4.1",
    "tokenx": "^1.3.0",
    "torph": "^0.0.9",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@cloudflare/vitest-pool-workers": "~0.15.1",
    "@iconify/json": "^2.2.467",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.59.1",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/rehype": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260318.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.5",
    "emulate": "0.5.0",
    "knip": "^6.7.0",
    "kysely-ctl": "~0.20.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.13.6",
    "oxfmt": "^0.40.0",
    "oxlint": "1.31.0",
    "playwright": "^1.59.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.0.2",
    "simple-git-hooks": "^2.13.1",
    "std-env": "^4.1.0",
    "tailwindcss": "^4.2.4",
    "testcontainers": "^11.14.0",
    "tiny-jsonc": "^1.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.86.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint",
    "*.{ts,tsx}": "bash -c 'pnpm check:types'"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.0.0+sha512.5bd187500e49cc6c3d891d973b432c02b844a5eb7209172c90a517a3ef4f579ed5c23d409b699e6a9dc418ff7b2b1890e63f6d74f1d3fc49848f37779c89c84c"
}
