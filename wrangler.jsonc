{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "curl",
  "main": "src/index.tsx",
  "compatibility_date": "2024-12-01",
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [{ "binding": "KV", "id": "curl_kv" }],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "curl-session-settle" }],
    "consumers": [
      {
        "queue": "curl-session-settle",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "HOST": "curl.local"
  },
  "env": {
    "production": {
      "name": "curl",
      "ai": {
        "binding": "AI"
      },
      "kv_namespaces": [{ "binding": "KV", "id": "curl_kv" }],
      "queues": {
        "producers": [{ "binding": "QUEUE", "queue": "curl-session-settle" }],
        "consumers": [
          {
            "queue": "curl-session-settle",
            "max_batch_size": 10,
            "max_batch_timeout": 30
          }
        ]
      },
      "vars": {
        "HOST": "curl.md"
      },
      "routes": [
        { "pattern": "curl.md/*", "zone_name": "curl.md" },
        { "pattern": "*.curl.md/*", "zone_name": "curl.md" }
      ]
    }
  }
}
